# Define a function to calculate the score
function Calculate-RBIScore {
    param (
        [int]$CurrentStreak,
        [double]$AverageStreak,
        [string]$Stadium,
        [string]$TimeOfDay,
        [string]$StartingPitcher,
        [double]$AverageDoublesPerBat,
        [string]$OpponentDefense,
        [string]$WeatherConditions,
        [int]$RecentPowerPerformance,
        [int]$BattingOrderPosition,
        [int]$RunnersInScoringPosition
    )

    # Initialize score
    $score = 0

    # Current Streak (Weight: 12)
    if ($CurrentStreak -gt 0) {
        $score += $CurrentStreak * 2 * 12
    } else {
        $score -= ($CurrentStreak * -1) * 2 * 12
    }

    # Average Streak (Weight: 10)
    if ($AverageStreak -gt 0.300) {
        $score += 4 * 10
    } elseif ($AverageStreak -lt 0.250) {
        $score -= 4 * 10
    }

    # Stadium (Weight: 8)
    if ($Stadium -eq "Pitcher-friendly") {
        $score += 3 * 8
    } elseif ($Stadium -eq "Hitter-friendly") {
        $score -= 3 * 8
    }

    # Time of Day (Weight: 5)
    if ($TimeOfDay -eq "Night") {
        $score += 2 * 5
    } elseif ($TimeOfDay -eq "Day") {
        $score -= 2 * 5
    }

    # Starting Pitcher (Weight: 15)
    if ($StartingPitcher -eq "Top-tier") {
        $score += 5 * 15
    } elseif ($StartingPitcher -eq "Lower-tier") {
        $score -= 5 * 15
    }

    # Average Doubles per Bat (Weight: 10)
    if ($AverageDoublesPerBat -lt 0.050) {
        $score += 4 * 10
    } elseif ($AverageDoublesPerBat -gt 0.100) {
        $score -= 4 * 10
    }

    # Opponent Team's Defense (Weight: 10)
    if ($OpponentDefense -eq "Strong") {
        $score += 3 * 10
    } elseif ($OpponentDefense -eq "Weak") {
        $score -= 3 * 10
    }

    # Weather Conditions (Weight: 5)
    if ($WeatherConditions -eq "Wind blowing in") {
        $score += 2 * 5
    } elseif ($WeatherConditions -eq "Wind blowing out") {
        $score -= 2 * 5
    }

    # Recent Power Performance (Weight: 10)
    if ($RecentPowerPerformance -eq 0) {
        $score += 4 * 10
    } elseif ($RecentPowerPerformance -ge 2) {
        $score -= 4 * 10
    }

    # Batting Order Position (Weight: 8)
    if ($BattingOrderPosition -ge 7) {
        $score += 3 * 8
    } elseif ($BattingOrderPosition -le 3) {
        $score -= 3 * 8
    }

    # Runners in Scoring Position (Weight: 12)
    if ($RunnersInScoringPosition -eq 0) {
        $score += 5 * 12
    } elseif ($RunnersInScoringPosition -ge 2) {
        $score -= 5 * 12
    }

    return $score
}

