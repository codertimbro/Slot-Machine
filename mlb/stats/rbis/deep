# Weighted RBI Avoidance Score Calculator for MLB Batters
# ------------------------------------------------------
# Lower total score = Higher probability of NOT getting an RBI

# Define Weights for Each Category (Adjust as Needed)
$weights = @{
    CurrentHitlessStreak = 8      # Higher weight for recent struggles
    AvgHitlessStreak     = 6      # Historical consistency of hitlessness
    StadiumFactor        = 7      # Pitcher-friendly parks get higher weight
    TimeOfDay            = 4      # Day/Night performance differences
    PitcherDominance     = 9      # Quality of starting pitcher (most impactful)
    AvgDoublesPerAB      = 5      # Fewer doubles = less RBI opportunities
    RBIsPerGame          = 7      # Direct historical RBI performance
    BullpenStrength      = 6      # Opponent's bullpen ERA
}

function Get-RBIAvoidanceScore {
    param(
        [int]$CurrentHitlessStreak,
        [double]$AvgHitlessStreak,
        [string]$Stadium,
        [ValidateSet("Day","Night")][string]$TimeOfDay,
        [double]$PitcherERA,          # Lower ERA = better pitcher
        [double]$AvgDoublesPerAB,
        [double]$RBIsPerGame,
        [double]$BullpenERA
    )

    # Category 1: Current Hitless Streak
    $currentStreakScore = switch ($CurrentHitlessStreak) {
        {$_ -ge 10} { 4 }  # Severe slump
        {$_ -ge 5}  { 3 }  # Significant slump
        {$_ -ge 3}  { 2 }  # Mild slump
        default      { 1 }  # Neutral
    } * $weights.CurrentHitlessStreak

    # Category 2: Average Hitless Streak
    $avgStreakScore = if ($AvgHitlessStreak -ge 5) { 3 } else { 2 } * $weights.AvgHitlessStreak

    # Category 3: Stadium Factor
    $stadiumScore = switch ($Stadium) {
        "Oracle Park"       { 5 }  # Pitcher-friendly
        "Comerica Park"     { 4 }
        "Yankee Stadium"    { 3 }
        "Coors Field"       { 1 }  # Hitter-friendly
        default             { 2 }
    } * $weights.StadiumFactor

    # Category 4: Time of Day
    $timeScore = if ($TimeOfDay -eq "Day") { 3 } else { 2 } * $weights.TimeOfDay

    # Category 5: Starting Pitcher Dominance
    $pitcherScore = switch ($PitcherERA) {
        {$_ -lt 3.00} { 5 }  # Elite pitcher
        {$_ -lt 3.50} { 4 }
        {$_ -lt 4.00} { 3 }
        default       { 2 }
    } * $weights.PitcherDominance

    # Category 6: Doubles Frequency
    $doublesScore = if ($AvgDoublesPerAB -lt 0.05) { 4 } else { 2 } * $weights.AvgDoublesPerAB

    # Category 7: Historical RBI Production
    $rbiScore = if ($RBIsPerGame -lt 0.3) { 5 } else { 2 } * $weights.RBIsPerGame

    # Category 8: Bullpen Strength
    $bullpenScore = switch ($BullpenERA) {
        {$_ -lt 3.30} { 4 }  # Strong bullpen
        {$_ -lt 3.80} { 3 }
        default        { 2 }
    } * $weights.BullpenStrength

    # Calculate Total Score
    $totalScore = $currentStreakScore + $avgStreakScore + $stadiumScore + 
                  $timeScore + $pitcherScore + $doublesScore + 
                  $rbiScore + $bullpenScore

    return $totalScore
}

# Example Usage
$batterScore = Get-RBIAvoidanceScore -CurrentHitlessStreak 7 `
                                      -AvgHitlessStreak 4.2 `
                                      -Stadium "Oracle Park" `
                                      -TimeOfDay "Night" `
                                      -PitcherERA 2.89 `
                                      -AvgDoublesPerAB 0.03 `
                                      -RBIsPerGame 0.25 `
                                      -BullpenERA 3.45

Write-Output "RBI Avoidance Score: $batterScore (Lower = Higher Avoidance Probability)"


 Key Stats for RBI Slumps
RBIs in Last 3+ Games

Target batters with 0 RBIs over their last 3+ games (use MLB Game Logs or FanGraphs).

Performance with Runners in Scoring Position (RISP)

Check their AVG/SLG with RISP during the streak.

AVG < .200 or SLG < .300 = struggles in clutch spots.

Compare to their career RISP stats (e.g., a career .280 hitter with RISP now hitting .150 suggests a slump).

Batted Ball Profile

Ground Ball Rate > 50%: Grounders rarely drive in runs unless they find gaps.

Low Hard-Hit% (< 35%): Weak contact reduces extra-base hits (key for RBIs).

High Pop-up Rate (> 15%): Easy outs waste scoring chances (use Baseball Savant).

Team Context: RISP Opportunities

If the team has a low OBP (.300 or worse) ahead of the batter, RBI chances are limited.

Example: A cleanup hitter with teammates failing to reach base ahead of him.

Plate Discipline

Chase Rate (O-Swing%) > 35%: Swinging at bad pitches leads to weak contact or strikeouts.

Low Walk Rate (< 6%): Few free passes mean fewer RBI chances via walks with bases loaded.

Contextual Factors
Lineup Position: Middle-of-the-order hitters (3-5 spots) get the most RBI chances. A slump here is more significant than for a leadoff hitter.

Pitcher Matchups: Facing elite pitchers (low ERA, high K%) reduces RBI opportunities.

Ballpark Factors: Pitcher-friendly parks (e.g., Oracle Park) suppress run-scoring.

Injuries: Key table-setters (e.g., leadoff hitters) missing games = fewer runners on base.

Workflow to Identify RBI Cold Streaks
Filter Batters: Use FanGraphs Leaderboards to find players with 0 RBIs in 3+ games.

Narrow Down:

Remove part-time players (e.g., < 10 PA in 3 games).

Eliminate hitters with strong underlying metrics (e.g., hard-hit% > 40%, xwOBA > .350).

Check Team Context:

Does the team rank bottom 10 in runs scored or OBP?

Are key runners (e.g., high-OBP leadoff hitters) injured?

Betting/DFS: Target "No RBI" props (e.g., DraftKings) for batters in poor matchups or team slumps.

Streak-Breaking Indicators
A batter’s RBI drought may end if:

Teammates’ OBP improves (e.g., leadoff hitter returns from injury).

They face a struggling pitcher (high WHIP, high ERA).

Their RISP luck improves (e.g., low BABIP with RISP despite strong contact).

Ballpark shift to a hitter-friendly venue (e.g., Coors Field).

Tools & Sources
RISP Stats: Baseball-Reference Splits.

Advanced Metrics: Baseball Savant’s Player Profiles (xBA, xSLG with RISP).

Team OBP/RISP: FanGraphs Team Stats.

Injury Reports: MLB Injury Tracker.
